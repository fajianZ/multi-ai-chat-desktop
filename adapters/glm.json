{"$schema":"./schema.json","adapterVersion":1,"displayName":"GLM","inputSelectors":["textarea#chat-input","textarea[id=\"chat-input\"]"],"inputStrategy":"default","loggedOutDetectors":[{"selector":"button","textIncludes":"Sign in"},{"selector":"button","textIncludes":"Log in"},"a[href*=\"login\"]"],"loginDetectors":["textarea#chat-input","#send-message-button"],"provider":"glm","responseSelectors":[".chat-assistant #response-content-container","#response-content-container","div[id^=\"message-\"] .markdown",".chat-assistant"],"schemaVersion":2,"sendButtonSelectors":["#send-message-button","button#send-message-button"],"sendStrategy":"click","stopButtonSelectors":["form button:has(span.block.size-3)","button[aria-label=\"Stop generating\"]","button[aria-label=\"Stop\"]"],"thinkingDetectors":[".thinking-chain-container","[class*=\"thinking-chain\"]","span.shimmer"],"timing":{"backupPollMs":3000,"chunkDebounceMs":600,"doneDelayMs":5000,"statusIntervalMs":10000},"urls":{"app":"https://chat.z.ai/","login":"https://chat.z.ai/","match":["chat.z.ai/*"],"ssoMatch":["accounts.google.com/*"]}}